  <!-- Splide Slider JS Library -->
  <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>

  <!-- Buttery Smooth Splide Carousel Controller -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const splideElement = document.querySelector('.splide');
      if (!splideElement) return;

      const slides = splideElement.querySelectorAll('.splide__slide');
      const totalSlidesCount = slides.length;
      const counterTotal = document.querySelector('.total-slides');
      const counterCurrent = document.querySelector('.current-slide');

      if (counterTotal) {
        counterTotal.textContent = String(totalSlidesCount).padStart(2, '0');
      }

      // Check if Splide library loaded successfully
      if (typeof Splide !== 'undefined' && totalSlidesCount > 0) {
        const isLoopable = totalSlidesCount >= 3;
        
        // Premium 60fps/120fps buttery glide configuration
        const splide = new Splide('.splide', {
          type: isLoopable ? 'loop' : 'slide',
          perPage: 3,
          perMove: 1,
          focus: 'center',
          trimSpace: false,
          gap: '2.25rem',
          padding: { left: '8%', right: '8%' },
          arrows: false,
          pagination: false,
          drag: true,
          
          /* Butter-smooth physics & easing */
          speed: 750,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          updateOnMove: true,        /* Smoothly scale active card DURING slide motion, not after */
          waitForTransition: false,  /* Allow seamless rapid clicking without stalling */
          flickPower: 600,
          flickMaxPages: 1,

          breakpoints: {
            1100: {
              perPage: 2,
              gap: '1.5rem',
              padding: { left: '6%', right: '6%' }
            },
            720: {
              perPage: 1,
              gap: '1rem',
              padding: { left: '10%', right: '10%' }
            }
          }
        });

        // Update custom counter smoothly in real-time as slide moves
        splide.on('move', (newIndex) => {
          if (counterCurrent) {
            const displayIndex = (newIndex % totalSlidesCount) + 1;
            counterCurrent.textContent = String(displayIndex).padStart(2, '0');
          }
        });

        splide.mount();

        // Bespoke circular control buttons with smooth debounced triggers
        const prevBtn = document.querySelector('.prev-splide');
        const nextBtn = document.querySelector('.next-splide');

        if (prevBtn) {
          prevBtn.addEventListener('click', (e) => {
            e.preventDefault();
            splide.go('<');
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', (e) => {
            e.preventDefault();
            splide.go('>');
          });
        }
      } else {
        // Fallback smooth scroll
        const track = document.querySelector('.splide__list');
        const prevBtn = document.querySelector('.prev-splide');
        const nextBtn = document.querySelector('.next-splide');

        if (prevBtn && track) {
          prevBtn.addEventListener('click', (e) => {
            e.preventDefault();
            track.scrollBy({ left: -380, behavior: 'smooth' });
          });
        }
        if (nextBtn && track) {
          nextBtn.addEventListener('click', (e) => {
            e.preventDefault();
            track.scrollBy({ left: 380, behavior: 'smooth' });
          });
        }
      }
    });
  </script>
</body>
</html>

<%- include("partials/header.ejs") %> 

<section class="blog-hero-section">
  <!-- Middle Part: Carousel displaying posted items as slides -->
  <div class="carousel-container">
    <div class="carousel-header">
      <div class="carousel-badge">Editorial Showcase</div>
      <h2 class="carousel-title">Posted Stories & Articles</h2>
      <p class="carousel-subtitle">Swipe or use controls to browse through published items.</p>
    </div>

    <!-- Carousel Component Viewport -->
    <div class="carousel-viewport">
      <button type="button" class="carousel-btn prev" aria-label="Previous Slide">&#10094;</button>
      
      <div class="carousel-track-wrapper">
        <div class="carousel-track">

          <!-- Slide 1 (Sample item / Template for EJS dynamic rendering) -->
          <% if (submittedData.length > 0){ %>
            <% submittedData.forEach((post, index) => { %>
              <% if (typeof post.slideTag !== 'undefined' && typeof post.slideHeading !== 'undefined' && typeof post.slideExcerpt !== 'undefined' && typeof post.authorName !== 'undefined') { %>
                <article class="carousel-slide">
                  <div class="slide-card">
                    <div class="slide-tag"><%= post.slideTag %></div>
                    <h3 class="slide-heading"><%= post.slideHeading %></h3>
                    <p class="slide-excerpt"><%= post.slideExcerpt %></p>
                    <div class="slide-meta">
                      <div class="author-info-group">
                        <div class="author-avatar"><%= post.authorName.trim().split(/\s+/).map(name => name[0]).join('').toUpperCase() %></div>
                        <div class="author-details">
                          <span class="author-name"><%= post.authorName %></span>
                          <span class="post-date">Published on <%= new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                        </div>
                      </div>
                      <!-- Post Card Action Buttons (Update & Delete) -->
                      <div class="post-card-actions">
                        <a href="/edit/<%=index%>">
                          <button type="button" class="btn-card-action btn-card-update" title="Update Story">
                            <span class="btn-icon">&#9998;</span>
                            <span class="btn-text">Update</span>
                          </button>
                        </a>
                        <a href="/delete/<%= index %>">
                          <button type="button" class="btn-card-action btn-card-delete" title="Delete Story">
                            <span class="btn-icon">&#128465;</span>
                            <span class="btn-text">Delete</span>
                          </button>
                        </a>
                      </div>
                    </div>
                  </div>
                </article>
              <% } %>
            <% }); %>
          <% } else {%>
            <article class="carousel-slide">
              <div class="slide-card">
                <div class="slide-tag"></div>
                <h3 class="slide-heading" style="text-align: center;">NO POSTS YET!!</h3>
                <p class="slide-excerpt"></p>
              </div>
            </article>
          <% } %>
        </div>
      </div>
      <button type="button" class="carousel-btn next" aria-label="Next Slide">&#10095;</button>
    </div>

    <!-- Carousel Pagination Indicators (Dots) -->
    <div class="carousel-indicators">
      <% if (locals.submittedData && submittedData.length > 0) { %>
        <% submittedData.forEach((post, index) => { %>
          <button type="button" class="carousel-dot" aria-label="Slide <%= index + 2 %>"></button>
        <% }); %>
      <% } else {%>
      <button type="button" class="carousel-dot active" aria-label="Slide 1"></button>
      <% } %>
    </div>
  </div>

  <!-- Bottom Part: Action Button (Post) -->
  <div class="bottom-action-bar">
    <div class="action-bar-inner">
      <!-- Post Button (Create) -->
      <a href="/post" class="btn btn-post" id="btnPost">
        <span class="btn-icon">+</span>
        <span class="btn-text">Post New Story</span>
      </a>
    </div>
  </div>
</section>

<%- include("partials/footer.ejs") %>

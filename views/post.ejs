<%- include("partials/header.ejs") %> 

<section class="editorial-form-section">
  <div class="editorial-form-card">
    
    <!-- Top Back Navigation -->
    <div class="form-top-nav">
      <a href="/" class="back-link">
        <span class="back-arrow">&larr;</span> Back to Stories
      </a>
      <span class="editorial-badge">
        <%= locals.isEditing ? "EDIT MODE" : "DRAFT MODE" %>
      </span>
    </div>

    <!-- Form Card Header -->
    <div class="form-header">
      <div class="form-kicker">// EDITORIAL STUDIO</div>
      <h1 class="form-title">
        <%= locals.isEditing ? "Update Story" : "Create New Story" %>
      </h1>
      <p class="form-subtitle">
        Fill out the fields below. Changes will be formatted and featured in the showcase carousel.
      </p>
    </div>

    <!-- Post Creation / Edit Form -->
    <form 
      action="<%= locals.isEditing ? '/edit/' + postId + '?_method=PATCH' : '/post' %>" 
      method="POST" 
      class="editorial-form" 
      id="createPostForm"
    >
      
      <!-- Field 1: slide-tag (Category Dropdown) -->
      <div class="form-group">
        <label for="slideTag" class="form-label">
          Category &bull; Topic Tag <span class="required">*</span>
        </label>
        <div class="select-wrapper">
          <select name="slideTag" id="slideTag" class="form-select" required>
            <option value="" disabled <%= !locals.post ? 'selected' : '' %>>Select a topic category...</option>
            <option value="DESIGN SYSTEMS &bull; 4 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('DESIGN') ? 'selected' : '' %>>Design Systems (4 min read)</option>
            <option value="ENGINEERING &bull; 6 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('ENGINEERING') ? 'selected' : '' %>>Engineering &amp; Architecture (6 min read)</option>
            <option value="TECHNOLOGY &bull; 5 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('TECH') ? 'selected' : '' %>>Technology Trends (5 min read)</option>
            <option value="AI &bull; 5 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('AI') ? 'selected' : '' %>>Artificial Intelligence (5 min read)</option>
            <option value="CRAFT &bull; 3 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('CRAFT') ? 'selected' : '' %>>Craft &amp; Typography (3 min read)</option>
            <option value="COLOPHON &bull; 2 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('COLOPHON') ? 'selected' : '' %>>Colophon &amp; Thoughts (2 min read)</option>
          </select>
        </div>
        <span class="form-helper">Category classification displayed on the card header.</span>
      </div>

      <!-- Field 2: slide-heading -->
      <div class="form-group">
        <label for="slideHeading" class="form-label">
          Headline / Title <span class="required">*</span>
        </label>
        <input 
          type="text" 
          name="slideHeading" 
          id="slideHeading" 
          class="form-input" 
          list="headingSuggestions"
          value="<%= locals.post ? post.slideHeading : '' %>"
          placeholder="e.g. The Architecture of High-Frequency Design Systems" 
          required 
          autocomplete="off"
        />
        <datalist id="headingSuggestions">
          <option value="Modern UI/UX Principles for Editorial & Content Platforms"></option>
          <option value="Mastering Express Routing and Middleware Architecture"></option>
          <option value="Building Scalable Web Applications with Modern Node.js"></option>
          <option value="The Philosophy of Restraint in Interface Design"></option>
        </datalist>
        <span class="form-helper">The primary editorial headline of your piece.</span>
      </div>

      <!-- Field 3: slide-excerpt -->
      <div class="form-group">
        <label for="slideExcerpt" class="form-label">
          Story Summary / Excerpt <span class="required">*</span>
        </label>
        <textarea 
          name="slideExcerpt" 
          id="slideExcerpt" 
          rows="4" 
          class="form-textarea" 
          placeholder="Write a thoughtful 2-3 sentence overview that captures the essence of your writing..."
          required
        ><%= locals.post ? post.slideExcerpt : '' %></textarea>
        <span class="form-helper">Summary text rendered inside the carousel card body.</span>
      </div>

      <!-- Field 4: author-name -->
      <div class="form-group">
        <label for="authorName" class="form-label">
          Byline / Author Name <span class="required">*</span>
        </label>
        <input 
          type="text" 
          name="authorName" 
          id="authorName" 
          class="form-input" 
          list="authorSuggestions"
          value="<%= locals.post ? post.authorName : '' %>"
          placeholder="e.g. Sharan Raj" 
          required 
          autocomplete="name"
        />
        <datalist id="authorSuggestions">
          <option value="Sharan Raj"></option>
          <option value="Editorial Team"></option>
          <option value="Guest Essayist"></option>
          <option value="Code Contributor"></option>
        </datalist>
        <span class="form-helper">The author byline shown in the publication metadata.</span>
      </div>

      <!-- Automated Meta Notice -->
      <div class="form-notice">
        <div class="notice-indicator">&bull;</div>
        <div class="notice-body">
          <p class="notice-title">Automated Metadata</p>
          <p class="notice-desc">
            Author avatar initials and publication timestamp are generated automatically upon saving.
          </p>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="form-actions">
        <a href="/" class="btn-ghost-cancel">Discard</a>
        <button type="submit" class="btn-editorial-submit">
          <span class="btn-dot"></span>
          <span><%= locals.isEditing ? 'Save Changes' : 'Publish Story' %></span>
        </button>
      </div>

    </form>

  </div>
</section>

<%- include("partials/footer.ejs") %>

<%- include("partials/header.ejs") %> 

<section class="editorial-form-section">
  <div class="editorial-form-card">
    
    <!-- Top Back Navigation -->
    <div class="form-top-nav">
      <a href="/" class="back-link">
        <span class="back-arrow">&larr;</span> Back to Stories
      </a>
      <span class="editorial-badge">
        <%= locals.isEditing ? "EDIT MODE" : "DRAFT MODE" %>
      </span>
    </div>

    <!-- Form Card Header -->
    <div class="form-header">
      <div class="form-kicker">// EDITORIAL STUDIO</div>
      <h1 class="form-title">
        <%= locals.isEditing ? "Update Story" : "Create New Story" %>
      </h1>
      <p class="form-subtitle">
        Fill out the fields below. Changes will be formatted and featured in the showcase carousel.
      </p>
    </div>

    <!-- Post Creation / Edit Form -->
    <form 
      action="<%= locals.isEditing ? '/edit/' + postId + '?_method=PATCH' : '/post' %>" 
      method="POST" 
      class="editorial-form" 
      id="createPostForm"
    >
      
      <!-- Field 1: slide-tag (Custom Styled Dropdown) -->
      <div class="form-group">
        <label class="form-label" id="categoryLabel">
          Category &bull; Topic Tag <span class="required">*</span>
        </label>

        <!-- Hidden Native Select (Keeps HTML5 Form Validation & req.body.slideTag in sync) -->
        <select name="slideTag" id="slideTag" class="native-select-hidden" required>
          <option value="" disabled <%= !locals.post ? 'selected' : '' %>>Select a topic category...</option>
          <option value="DESIGN SYSTEMS &bull; 4 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('DESIGN') ? 'selected' : '' %>>DESIGN SYSTEMS &bull; 4 MIN</option>
          <option value="ENGINEERING &bull; 6 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('ENGINEERING') ? 'selected' : '' %>>ENGINEERING &bull; 6 MIN</option>
          <option value="TECHNOLOGY &bull; 5 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('TECH') ? 'selected' : '' %>>TECHNOLOGY &bull; 5 MIN</option>
          <option value="AI &bull; 5 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('AI') ? 'selected' : '' %>>AI &bull; 5 MIN</option>
          <option value="CRAFT &bull; 3 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('CRAFT') ? 'selected' : '' %>>CRAFT &bull; 3 MIN</option>
          <option value="COLOPHON &bull; 2 MIN" <%= locals.post && post.slideTag && post.slideTag.includes('COLOPHON') ? 'selected' : '' %>>COLOPHON &bull; 2 MIN</option>
        </select>

        <!-- Custom Styled Dropdown Component -->
        <div class="custom-select-container" id="customSelectContainer">
          <button 
            type="button" 
            class="custom-select-trigger <%= locals.post && post.slideTag ? 'has-value' : '' %>" 
            id="customSelectTrigger" 
            aria-haspopup="listbox" 
            aria-expanded="false"
            aria-labelledby="categoryLabel"
          >
            <span class="trigger-label" id="triggerLabel">
              <%= locals.post && post.slideTag ? post.slideTag : "Select a topic category..." %>
            </span>
            <span class="trigger-chevron">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 6 8 10 12 6"></polyline>
              </svg>
            </span>
          </button>

          <!-- Modern Expanded Floating Menu -->
          <div class="custom-select-dropdown" id="customSelectDropdown" role="listbox">
            <div class="dropdown-header">
              <span class="dropdown-kicker">// SELECT TOPIC CLASSIFICATION</span>
            </div>

            <div class="custom-option <%= locals.post && post.slideTag && post.slideTag.includes('DESIGN') ? 'is-selected' : '' %>" data-value="DESIGN SYSTEMS &bull; 4 MIN" role="option">
              <div class="option-main">
                <span class="option-title">Design Systems</span>
                <span class="option-badge">4 MIN READ</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option <%= locals.post && post.slideTag && post.slideTag.includes('ENGINEERING') ? 'is-selected' : '' %>" data-value="ENGINEERING &bull; 6 MIN" role="option">
              <div class="option-main">
                <span class="option-title">Engineering &amp; Architecture</span>
                <span class="option-badge">6 MIN READ</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option <%= locals.post && post.slideTag && post.slideTag.includes('TECH') ? 'is-selected' : '' %>" data-value="TECHNOLOGY &bull; 5 MIN" role="option">
              <div class="option-main">
                <span class="option-title">Technology Trends</span>
                <span class="option-badge">5 MIN READ</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option <%= locals.post && post.slideTag && post.slideTag.includes('AI') ? 'is-selected' : '' %>" data-value="AI &bull; 5 MIN" role="option">
              <div class="option-main">
                <span class="option-title">Artificial Intelligence</span>
                <span class="option-badge">5 MIN READ</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option <%= locals.post && post.slideTag && post.slideTag.includes('CRAFT') ? 'is-selected' : '' %>" data-value="CRAFT &bull; 3 MIN" role="option">
              <div class="option-main">
                <span class="option-title">Craft &amp; Typography</span>
                <span class="option-badge">3 MIN READ</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option <%= locals.post && post.slideTag && post.slideTag.includes('COLOPHON') ? 'is-selected' : '' %>" data-value="COLOPHON &bull; 2 MIN" role="option">
              <div class="option-main">
                <span class="option-title">Colophon &amp; Thoughts</span>
                <span class="option-badge">2 MIN READ</span>
              </div>
              <span class="option-check">&check;</span>
            </div>
          </div>
        </div>

        <span class="form-helper">Category classification displayed on the card header.</span>
      </div>

      <!-- Field 2: slide-heading (Modern Dropdown Combobox) -->
      <div class="form-group">
        <label for="slideHeading" class="form-label">
          Headline / Title <span class="required">*</span>
        </label>
        
        <div class="custom-combobox-container" id="headingCombobox">
          <div class="input-with-chevron">
            <input 
              type="text" 
              name="slideHeading" 
              id="slideHeading" 
              class="form-input combobox-input" 
              value="<%= locals.post ? post.slideHeading : '' %>"
              placeholder="e.g. The Architecture of High-Frequency Design Systems" 
              required 
              autocomplete="off"
            />
            <button type="button" class="combobox-trigger-btn" aria-label="Toggle Headline Suggestions">
              <span class="trigger-chevron">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="4 6 8 10 12 6"></polyline>
                </svg>
              </span>
            </button>
          </div>

          <!-- Modern Expanded Floating Menu (Identical Style) -->
          <div class="custom-select-dropdown combobox-dropdown" role="listbox">
            <div class="dropdown-header">
              <span class="dropdown-kicker">// EDITORIAL HEADLINE SUGGESTIONS</span>
            </div>

            <div class="custom-option" data-value="Modern UI/UX Principles for Editorial &amp; Content Platforms" role="option">
              <div class="option-main">
                <span class="option-title">Modern UI/UX Principles for Editorial &amp; Content Platforms</span>
                <span class="option-badge">DESIGN</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option" data-value="Mastering Express Routing and Middleware Architecture" role="option">
              <div class="option-main">
                <span class="option-title">Mastering Express Routing and Middleware Architecture</span>
                <span class="option-badge">DEV</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option" data-value="Building Scalable Web Applications with Modern Node.js" role="option">
              <div class="option-main">
                <span class="option-title">Building Scalable Web Applications with Modern Node.js</span>
                <span class="option-badge">ARCHITECTURE</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option" data-value="The Philosophy of Restraint in Modern Interface Design" role="option">
              <div class="option-main">
                <span class="option-title">The Philosophy of Restraint in Modern Interface Design</span>
                <span class="option-badge">CRAFT</span>
              </div>
              <span class="option-check">&check;</span>
            </div>
          </div>
        </div>

        <span class="form-helper">Type a custom headline or select an editorial suggestion from the dropdown.</span>
      </div>

      <!-- Field 3: slide-excerpt -->
      <div class="form-group">
        <label for="slideExcerpt" class="form-label">
          Story Summary / Excerpt <span class="required">*</span>
        </label>
        <textarea 
          name="slideExcerpt" 
          id="slideExcerpt" 
          rows="4" 
          class="form-textarea" 
          placeholder="Write a thoughtful 2-3 sentence overview that captures the essence of your writing..."
          required
        ><%= locals.post ? post.slideExcerpt : '' %></textarea>
        <span class="form-helper">Summary text rendered inside the carousel card body.</span>
      </div>

      <!-- Field 4: author-name (Modern Dropdown Combobox) -->
      <div class="form-group">
        <label for="authorName" class="form-label">
          Byline / Author Name <span class="required">*</span>
        </label>

        <div class="custom-combobox-container" id="authorCombobox">
          <div class="input-with-chevron">
            <input 
              type="text" 
              name="authorName" 
              id="authorName" 
              class="form-input combobox-input" 
              value="<%= locals.post ? post.authorName : '' %>"
              placeholder="e.g. Sharan Raj" 
              required 
              autocomplete="off"
            />
            <button type="button" class="combobox-trigger-btn" aria-label="Toggle Author Suggestions">
              <span class="trigger-chevron">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="4 6 8 10 12 6"></polyline>
                </svg>
              </span>
            </button>
          </div>

          <!-- Modern Expanded Floating Menu (Identical Style) -->
          <div class="custom-select-dropdown combobox-dropdown" role="listbox">
            <div class="dropdown-header">
              <span class="dropdown-kicker">// SELECT OR TYPE AUTHOR BYLINE</span>
            </div>

            <div class="custom-option" data-value="Sharan Raj" role="option">
              <div class="option-main">
                <span class="option-title">Sharan Raj</span>
                <span class="option-badge">AUTHOR</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option" data-value="Editorial Team" role="option">
              <div class="option-main">
                <span class="option-title">Editorial Team</span>
                <span class="option-badge">CURATOR</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option" data-value="Guest Essayist" role="option">
              <div class="option-main">
                <span class="option-title">Guest Essayist</span>
                <span class="option-badge">CONTRIBUTOR</span>
              </div>
              <span class="option-check">&check;</span>
            </div>

            <div class="custom-option" data-value="Code Contributor" role="option">
              <div class="option-main">
                <span class="option-title">Code Contributor</span>
                <span class="option-badge">OPEN SOURCE</span>
              </div>
              <span class="option-check">&check;</span>
            </div>
          </div>
        </div>

        <span class="form-helper">Type your author name or select a byline profile from the dropdown.</span>
      </div>

      <!-- Automated Meta Notice -->
      <div class="form-notice">
        <div class="notice-indicator">&bull;</div>
        <div class="notice-body">
          <p class="notice-title">Automated Metadata</p>
          <p class="notice-desc">
            Author avatar initials and publication timestamp are generated automatically upon saving.
          </p>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="form-actions">
        <a href="/" class="btn-ghost-cancel">Discard</a>
        <button type="submit" class="btn-editorial-submit">
          <span class="btn-dot"></span>
          <span><%= locals.isEditing ? 'Save Changes' : 'Publish Story' %></span>
        </button>
      </div>

    </form>

  </div>
</section>

<!-- Unified Custom Dropdowns & Comboboxes Controller -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Setup Category Custom Select
    setupCustomSelect('customSelectContainer', 'customSelectTrigger', 'customSelectDropdown', 'triggerLabel', 'slideTag');

    // 2. Setup Headline Combobox Dropdown
    setupCombobox('headingCombobox', 'slideHeading');

    // 3. Setup Author Combobox Dropdown
    setupCombobox('authorCombobox', 'authorName');

    // Helper: Category Select
    function setupCustomSelect(containerId, triggerId, dropdownId, labelId, nativeSelectId) {
      const container = document.getElementById(containerId);
      const trigger = document.getElementById(triggerId);
      const dropdown = document.getElementById(dropdownId);
      const triggerLabel = document.getElementById(labelId);
      const nativeSelect = document.getElementById(nativeSelectId);

      if (!container || !trigger || !dropdown || !nativeSelect) return;
      const options = dropdown.querySelectorAll('.custom-option');

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeAllExcept(container);
        const isOpen = container.classList.toggle('is-open');
        trigger.setAttribute('aria-expanded', isOpen);
      });

      options.forEach((opt) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const value = opt.getAttribute('data-value');
          nativeSelect.value = value;
          triggerLabel.textContent = value;
          trigger.classList.add('has-value');

          options.forEach((o) => o.classList.remove('is-selected'));
          opt.classList.add('is-selected');

          container.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        });
      });
    }

    // Helper: Combobox (Editable Input + Custom Floating Dropdown)
    function setupCombobox(containerId, inputId) {
      const container = document.getElementById(containerId);
      if (!container) return;

      const input = document.getElementById(inputId);
      const triggerBtn = container.querySelector('.combobox-trigger-btn');
      const dropdown = container.querySelector('.custom-select-dropdown');
      if (!input || !dropdown) return;

      const options = dropdown.querySelectorAll('.custom-option');

      // Check initial selected state
      const initialVal = input.value.trim().toLowerCase();
      if (initialVal) {
        options.forEach(opt => {
          if (opt.getAttribute('data-value').trim().toLowerCase() === initialVal) {
            opt.classList.add('is-selected');
          }
        });
      }

      function openMenu() {
        closeAllExcept(container);
        container.classList.add('is-open');
        if (triggerBtn) triggerBtn.setAttribute('aria-expanded', 'true');
      }

      function closeMenu() {
        container.classList.remove('is-open');
        if (triggerBtn) triggerBtn.setAttribute('aria-expanded', 'false');
      }

      // Toggle on chevron button click
      if (triggerBtn) {
        triggerBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          e.preventDefault();
          container.classList.contains('is-open') ? closeMenu() : openMenu();
        });
      }

      // Open on input focus
      input.addEventListener('focus', () => {
        openMenu();
      });

      // Select an option from the dropdown
      options.forEach((opt) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const value = opt.getAttribute('data-value');
          input.value = value;

          options.forEach((o) => o.classList.remove('is-selected'));
          opt.classList.add('is-selected');

          closeMenu();
          input.focus();
        });
      });

      // Synchronize checkmarks if user types manually
      input.addEventListener('input', () => {
        const cur = input.value.trim().toLowerCase();
        options.forEach(opt => {
          const val = opt.getAttribute('data-value').trim().toLowerCase();
          opt.classList.toggle('is-selected', cur.length > 0 && cur === val);
        });
      });
    }

    // Helper: Close all dropdowns
    function closeAllExcept(activeContainer) {
      document.querySelectorAll('.custom-select-container, .custom-combobox-container').forEach(c => {
        if (c !== activeContainer) {
          c.classList.remove('is-open');
          const t = c.querySelector('button');
          if (t) t.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Global click outside to close
    document.addEventListener('click', (e) => {
      document.querySelectorAll('.custom-select-container.is-open, .custom-combobox-container.is-open').forEach(c => {
        if (!c.contains(e.target)) {
          c.classList.remove('is-open');
          const t = c.querySelector('button');
          if (t) t.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Global Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllExcept(null);
      }
    });
  });
</script>

<%- include("partials/footer.ejs") %>
